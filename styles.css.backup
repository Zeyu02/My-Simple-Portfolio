* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --background: 216 47% 98%;
    --foreground: 222 47% 11%;
    --card: 0 0% 100%;
    --card-foreground: 222 47% 11%;
    --popover: 216 47% 98%;
    --popover-foreground: 222 47% 11%;
    --primary: 229 84% 52%;
    --primary-foreground: 0 0% 100%;
    --secondary: 214 80% 96%;
    --secondary-foreground: 222 47% 11%;
    --muted: 216 47% 95%;
    --muted-foreground: 215 16% 47%;
    --accent: 229 84% 96%;
    --accent-foreground: 222 47% 11%;
    --border: 214 32% 91%;
    --ring: 229 84% 52%;
    --radius: 1.15rem;
    --shadow: 0 24px 80px hsl(222 47% 11% / 0.10);
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.contact-link {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
}

.contact-link:hover {
    text-decoration: underline;
}

:focus-visible {
    outline: 3px solid hsl(var(--ring) / 0.45);
    outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
    html {
        scroll-behavior: auto;
    }
}

[hidden] {
    display: none !important;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
        radial-gradient(circle at 10% 10%, hsl(229 84% 88% / 0.72), transparent 28rem),
        radial-gradient(circle at 88% 18%, hsl(16 100% 88% / 0.62), transparent 26rem),
        radial-gradient(circle at 50% 100%, hsl(263 70% 92% / 0.72), transparent 34rem),
        hsl(var(--background));
    color: hsl(var(--foreground));
    line-height: 1.6;
    overflow-x: hidden;
}

body.modal-open {
    overflow: hidden;
}

body,
button,
input,
textarea {
    font-family: inherit;
}

a {
    color: inherit;
}

button {
    font: inherit;
}

.container {
    width: min(1120px, calc(100% - 4rem));
    margin: 0 auto;
}

section {
    scroll-margin-top: 5.5rem;
}

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--card) / 0.82);
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 40px hsl(222 47% 11% / 0.06);
    transition: box-shadow 0.2s ease, background-color 0.2s ease;
}

.navbar.scrolled {
    background: hsl(var(--card) / 0.94);
    box-shadow: 0 16px 48px hsl(222 47% 11% / 0.10);
}

.nav-container {
    width: min(1120px, calc(100% - 4rem));
    min-height: 74px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
}

.logo-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: calc(var(--radius) - 0.25rem);
    background: linear-gradient(135deg, #ff6b35, #ff9f1c);
    color: #fff;
    box-shadow: 0 14px 34px hsl(16 100% 50% / 0.22);
}

.nav-menu {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 0.9rem;
    border-radius: calc(var(--radius) - 0.45rem);
    color: hsl(var(--muted-foreground));
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.nav-link:hover,
.nav-link.active {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    transform: translateY(-1px);
}

.contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: calc(var(--radius) - 0.45rem);
    background: hsl(var(--foreground));
    color: #fff;
    font-size: 0.94rem;
    font-weight: 750;
    text-decoration: none;
    box-shadow: 0 14px 34px hsl(222 47% 11% / 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
}

.contact-btn:hover {
    transform: translateY(-2px);
    background: hsl(var(--primary));
    box-shadow: 0 18px 46px hsl(229 84% 52% / 0.28);
}

.hamburger {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) - 0.45rem);
    background: hsl(var(--card));
    cursor: pointer;
}

.hamburger span {
    width: 19px;
    height: 2px;
    border-radius: 999px;
    background: hsl(var(--foreground));
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(hsl(var(--border)) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--border)) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(circle at 50% 45%, black, transparent 76%);
    mask-image: radial-gradient(circle at 50% 45%, black, transparent 76%);
    opacity: 0.48;
}

.hero::after {
    content: '';
    position: absolute;
    right: -12rem;
    top: 12rem;
    width: 28rem;
    height: 28rem;
    border-radius: 999px;
    background: hsl(229 84% 52% / 0.08);
    filter: blur(8px);
}

.hero-container {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100% - 4rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: 4rem;
}

.greeting {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.42rem 0.85rem;
    border: 1px solid hsl(var(--primary) / 0.22);
    border-radius: 999px;
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.greeting::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 7px hsl(var(--primary) / 0.12);
}

.hero-title {
    max-width: 760px;
    margin-bottom: 1.35rem;
    font-size: clamp(3.4rem, 8vw, 6.4rem);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.08em;
    color: hsl(var(--foreground));
}

.highlight {
    color: hsl(var(--primary));
    background: linear-gradient(135deg, hsl(var(--primary)), #7c3aed);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-description {
    max-width: 620px;
    margin-bottom: 2rem;
    color: hsl(var(--muted-foreground));
    font-size: 1.08rem;
}

.hero-description strong {
    color: hsl(var(--foreground));
}

.hero-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.1rem;
}

.btn-primary,
.btn-secondary,
.btn-submit {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify: center;
    padding: 0 1.4rem;
    border: 0;
    border-radius: calc(var(--radius) - 0.2rem);
    font-size: 0.96rem;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease;
}

.btn-primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    box-shadow: 0 18px 42px hsl(var(--primary) / 0.26);
}

.btn-secondary {
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    color: hsl(var(--foreground));
}

.btn-primary:hover,
.btn-secondary:hover,
.btn-submit:hover {
    transform: translateY(-2px);
}

.btn-primary:hover {
    box-shadow: 0 24px 54px hsl(var(--primary) / 0.34);
}

.btn-secondary:hover {
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
}

.social-icons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.social-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    text-decoration: none;
    box-shadow: 0 12px 30px hsl(222 47% 11% / 0.08);
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
}

.social-icon:hover {
    transform: translateY(-2px);
    border-color: hsl(var(--primary) / 0.45);
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
}

.social-icon.facebook:hover {
    border-color: #1877f2;
    background: #1877f2;
    color: #fff;
}

.social-icon.github:hover {
    border-color: #111827;
    background: #111827;
    color: #fff;
}

.hero-image {
    position: relative;
}

.image-backdrop {
    position: relative;
    width: min(450px, 100%);
    aspect-ratio: 1;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 2.5rem;
    background:
        linear-gradient(135deg, hsl(var(--card) / 0.96), hsl(216 47% 98% / 0.96)),
        radial-gradient(circle at 50% 0%, hsl(var(--primary) / 0.18), transparent 44%);
    box-shadow: var(--shadow);
    overflow: hidden;
}

.image-backdrop::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px dashed hsl(var(--primary) / 0.28);
    border-radius: 2rem;
}

.tech-circle {
    position: absolute;
    width: 440px;
    height: 440px;
    border: 1px solid hsl(var(--primary) / 0.24);
    border-radius: 50%;
    animation: rotate 28s linear infinite;
}

.tech-circle::before,
.tech-circle::after {
    content: '';
    position: absolute;
    border: 1px solid hsl(var(--primary) / 0.18);
    border-radius: 50%;
}

.tech-circle::before {
    width: 250px;
    height: 250px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: rotate 18s linear infinite reverse;
}

.tech-circle::after {
    width: 170px;
    height: 170px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: rotate 12s linear infinite;
}

.avatar-placeholder {
    position: relative;
    z-index: 1;
    width: 420px;
    height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 2rem;
    background:
        radial-gradient(circle at 30% 20%, hsl(var(--primary) / 0.20), transparent 38%),
        linear-gradient(145deg, hsl(var(--card)), hsl(var(--muted)));
    overflow: hidden;
}

.profile-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.floating-element {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 36px;
    padding: 0 0.75rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card) / 0.92);
    color: hsl(var(--primary));
    font-size: 0.84rem;
    font-weight: 800;
    box-shadow: 0 18px 44px hsl(222 47% 11% / 0.14);
    animation: float 3.5s ease-in-out infinite;
}

.element-1 {
    top: 12%;
    right: 7%;
}

.element-2 {
    bottom: 22%;
    left: 5%;
    animation-delay: 1s;
}

.element-3 {
    top: 54%;
    left: 0%;
    animation-delay: 2s;
}

.hero-review-card {
    position: absolute !important;
    bottom: -100px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 3 !important;
    width: auto !important;
    max-width: 220px !important;
    padding: 0.9rem 1.2rem !important;
    border-radius: 1rem !important;
    background: hsla(216, 47%, 98%, 0.6) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid hsla(var(--border), 0.3) !important;
    box-shadow: 0 6px 16px hsla(222, 47%, 11%, 0.08) !important;
    text-align: center !important;
}
.hero-review-card span {
    display: block !important;
    color: hsl(var(--muted-foreground)) !important;
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.02em !important;
}
.hero-review-card strong {
    display: block !important;
    margin-top: 0.3rem !important;
    color: hsl(var(--foreground)) !important;
    font-size: 1.08rem !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em !important;
}

.hero-review-card span {
    display: block !important;
    color: hsl(var(--muted-foreground)) !important;
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.02em !important;
}

.hero-review-card strong {
    display: block !important;
    margin-top: 0.3rem !important;
    color: hsl(var(--foreground)) !important;
    font-size: 1.08rem !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em !important;
}

.scroll-indicator {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    animation: bounce 2s infinite;
}

.mouse {
    width: 28px;
    height: 46px;
    display: flex;
    justify-content: center;
    padding-top: 10px;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card) / 0.78);
    backdrop-filter: blur(12px);
}

.wheel {
    width: 4px;
    height: 8px;
    border-radius: 999px;
    background: hsl(var(--primary));
    animation: scroll 1.5s infinite;
}

.about,
.skills,
.services,
.projects,
.contact {
    position: relative;
    padding: 6rem 0;
}

.about,
.contact {
    background: hsl(var(--card) / 0.54);
}

.skills,
.services {
    background: hsl(var(--muted) / 0.55);
}

.section-header {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto 3.8rem;
    text-align: center;
}

.section-title {
    position: relative;
    display: inline-block;
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 5vw, 3.9rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.06em;
}

.section-title > span:not(.hover-letter):not(.highlight) {
    background: linear-gradient(135deg, hsl(var(--foreground)), hsl(var(--primary)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hover-letter {
    position: relative;
    display: inline-block;
    cursor: pointer;
    color: hsl(var(--primary));
    transition: transform 0.2s ease, text-shadow 0.2s ease;
}

.hover-letter:hover {
    transform: translateY(-4px);
    text-shadow: 0 0 24px hsl(var(--primary) / 0.35);
}

.hover-letter::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.45rem;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: hsl(var(--primary));
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
}

.hover-letter:hover::after {
    transform: translateX(-50%) scaleX(1);
}

.section-subtitle {
    color: hsl(var(--muted-foreground));
    font-size: 1.05rem;
}

.title-decoration {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
}

.title-decoration .line {
    width: 76px;
    height: 1px;
    background: linear-gradient(90deg, transparent, hsl(var(--primary)), transparent);
}

.title-decoration .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: hsl(var(--primary));
    box-shadow: 0 0 24px hsl(var(--primary) / 0.45);
    animation: pulse 2s ease-in-out infinite;
}

.about-content,
.contact-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: center;
}

.image-frame {
    position: relative;
    width: min(480px, 100%);
    margin: 0 auto;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 2rem;
    background: hsl(var(--card));
    box-shadow: var(--shadow);
}

.avatar-large {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background:
        radial-gradient(circle at 24% 18%, hsl(var(--primary) / 0.22), transparent 36%),
        linear-gradient(145deg, hsl(var(--popover)), hsl(var(--card)));
}

.profile-image-large {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.experience-badge {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) - 0.25rem);
    background: hsl(var(--card) / 0.94);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 46px hsl(222 47% 11% / 0.16);
}

.badge-number {
    color: hsl(var(--primary));
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
}

.badge-text {
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.about-text h3,
.contact-info h3 {
    margin-bottom: 1.25rem;
    color: hsl(var(--foreground));
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 900;
    letter-spacing: -0.04em;
}

.about-text p,
.contact-info p {
    color: hsl(var(--muted-foreground));
    margin-bottom: 1.25rem;
    font-size: 1.02rem;
}

.about-text strong {
    color: hsl(var(--primary));
}

.about-skills {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
}

.about-skill-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
    font-size: 0.92rem;
}

.about-skill-label strong {
    color: hsl(var(--foreground));
}

.about-skill-label b {
    color: hsl(var(--primary));
}

.about-skill-track {
    width: 100%;
    height: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: hsl(var(--muted));
}

.about-skill-track i {
    display: block;
    height: 100%;
    width: var(--progress-width, 0%);
    border-radius: inherit;
    background: linear-gradient(90deg, hsl(var(--primary)), #7c3aed);
    transition: width 0.9s ease;
}

.about-stats,
.services-grid {
    display: grid;
    gap: 1rem;
}

.about-stats {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 2rem;
}

.stat,
.service-card,
.skill-card,
.project-card,
.contact-item,
.contact-form {
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    box-shadow: 0 18px 54px hsl(222 47% 11% / 0.08);
}

.stat {
    padding: 1.25rem;
    border-radius: var(--radius);
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
}

.stat:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--primary) / 0.45);
    background: hsl(var(--accent));
}

.stat i {
    margin-bottom: 0.85rem;
    color: hsl(var(--primary));
    font-size: 2rem;
}

.stat h4 {
    margin-bottom: 0.35rem;
    font-size: 0.98rem;
}

.stat p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.86rem;
}

.services-grid {
    position: relative;
    z-index: 1;
    grid-template-columns: repeat(4, 1fr);
}

.service-card {
    position: relative;
    overflow: hidden;
    min-height: 245px;
    padding: 1.4rem;
    border-radius: var(--radius);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
}

.service-card::after {
    content: '';
    position: absolute;
    right: -4rem;
    top: -4rem;
    width: 9rem;
    height: 9rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.08);
    transition: transform 0.2s ease;
}

.service-card:hover {
    transform: translateY(-6px);
    border-color: hsl(var(--primary) / 0.45);
    box-shadow: 0 28px 76px hsl(var(--primary) / 0.13);
}

.service-card:hover::after {
    transform: scale(1.2);
}

.service-icon {
    position: relative;
    z-index: 1;
    width: 58px;
    height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    border-radius: calc(var(--radius) - 0.35rem);
    background: hsl(var(--primary) / 0.10);
    color: hsl(var(--primary));
    font-size: 1.45rem;
}

.service-card h3 {
    position: relative;
    z-index: 1;
    margin-bottom: 0.65rem;
    font-size: 1.15rem;
    font-weight: 850;
    letter-spacing: -0.03em;
}

.service-card p {
    position: relative;
    z-index: 1;
    color: hsl(var(--muted-foreground));
    font-size: 0.94rem;
}

.skills {
    padding: 5rem 0;
}

.skills-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
}

.skill-card {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: var(--radius);
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
}

.skill-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, hsl(var(--primary) / 0.10), transparent);
    transform: translateX(-100%);
    transition: transform 0.5s ease;
}

.skill-card:hover::before {
    transform: translateX(100%);
}

.skill-card:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--ring) / 0.55);
    background: hsl(var(--accent));
    box-shadow: 0 24px 64px hsl(var(--primary) / 0.12);
}

.skill-icon {
    position: relative;
    z-index: 1;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid hsl(var(--primary) / 0.28);
    border-radius: calc(var(--radius) - 0.25rem);
    background: hsl(var(--primary) / 0.10);
    color: hsl(var(--primary));
    font-size: 1.35rem;
    transition: transform 0.2s ease, background-color 0.2s ease;
}

.skill-card:hover .skill-icon {
    transform: scale(1.04);
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
}

.skill-card h4 {
    position: relative;
    z-index: 1;
    margin-bottom: 0.85rem;
    font-size: 0.98rem;
}

.skill-bar {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: hsl(var(--muted));
}

.skill-progress {
    height: 100%;
    width: var(--progress-width, 0%);
    border-radius: inherit;
    background: linear-gradient(90deg, hsl(var(--primary)), #7c3aed);
    transition: width 0.9s ease;
}

.portfolio-filter {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: -1rem 0 2.5rem;
    padding: 0.5rem;
    background: hsl(var(--card) / 0.6);
    border: 1px hsl(var(--border));
    border-radius: 999px;
    box-shadow: 0 8px 32px hsl(222 47% 11% / 0.06);
    backdrop-filter: blur(12px);
}

.filter-btn {
    position: relative;
    min-height: 40px;
    padding: 0 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease;
}

.filter-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: hsl(var(--primary));
    transform: scale(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: -1;
}

.filter-btn:hover {
    color: hsl(var(--foreground));
    transform: translateY(-1px);
}

.filter-btn:hover::before {
    transform: scale(0.3);
}

.filter-btn.active,
.filter-btn[aria-pressed="true"] {
    color: hsl(var(--primary-foreground));
}

.filter-btn.active::before,
.filter-btn[aria-pressed="true"]::before {
    transform: scale(1);
}

.projects-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
}

.project-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: hsl(var(--ring) / 0.55);
    box-shadow: 0 28px 76px hsl(var(--primary) / 0.13);
}

.project-card-link {
    display: flex;
    color: inherit;
    text-decoration: none;
}

.project-card-link:visited {
    color: inherit;
}

.project-card-link .project-link {
    pointer-events: none;
}

.project-image {
    position: relative;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
        radial-gradient(circle at 30% 20%, hsl(var(--primary) / 0.22), transparent 38%),
        linear-gradient(135deg, hsl(var(--muted)), hsl(var(--card)));
}

.project-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, hsl(var(--foreground) / 0.08), transparent);
    transform: translateX(-100%);
    transition: transform 0.5s ease;
}

.project-card:hover .project-image::before {
    transform: translateX(100%);
}

.project-image i {
    position: relative;
    z-index: 1;
    color: hsl(var(--primary));
    font-size: 4rem;
    filter: drop-shadow(0 14px 28px hsl(var(--primary) / 0.20));
    transition: transform 0.2s ease;
}

.project-card:hover .project-image i {
    transform: scale(1.08) rotate(6deg);
}

.video-wrapper {
    height: 165px;
    padding: 0;
    background: #000;
}

.project-video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.school-video-card .video-wrapper {
    cursor: pointer;
}

.school-video-card .video-wrapper::after {
    content: 'Tap to enlarge';
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--card) / 0.86);
    color: hsl(var(--foreground));
    font-size: 0.72rem;
    backdrop-filter: blur(12px);
}

.school-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
}

.school-video-card .project-content {
    padding: 1rem;
}

.school-video-card .project-content h3 {
    min-height: 2.7em;
    margin-bottom: 0.6rem;
    font-size: 1rem;
    line-height: 1.35;
}

.school-video-card .project-link {
    font-size: 0.88rem;
}

.project-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.35rem;
}

.project-content h3 {
    margin-bottom: 0.65rem;
    font-size: 1.18rem;
    font-weight: 850;
    letter-spacing: -0.025em;
}

.project-content p {
    margin-bottom: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.94rem;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
}

.tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 0.65rem;
    border: 1px solid hsl(var(--primary) / 0.22);
    border-radius: 999px;
    background: hsl(var(--primary) / 0.10);
    color: hsl(var(--primary));
    font-size: 0.78rem;
    font-weight: 700;
    transition: transform 0.2s ease, background-color 0.2s ease;
}

.tag:hover {
    transform: scale(1.04);
    background: hsl(var(--primary) / 0.16);
}

.project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    color: hsl(var(--primary));
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    transition: gap 0.2s ease;
}

.project-link:hover {
    gap: 0.8rem;
}

.video-modal {
    position: fixed;
    inset: 0;
    z-index: 5000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.video-modal.open {
    display: flex;
}

.video-modal-backdrop {
    position: absolute;
    inset: 0;
    background: hsl(222 47% 11% / 0.72);
    backdrop-filter: blur(8px);
}

.video-modal-dialog {
    position: relative;
    z-index: 1;
    width: min(1000px, 96vw);
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.25rem;
    background: hsl(var(--card));
    box-shadow: 0 32px 96px hsl(222 47% 11% / 0.34);
}

.modal-video {
    width: 100%;
    max-height: 78vh;
    display: block;
    border-radius: calc(var(--radius) - 0.25rem);
    background: #000;
}

.video-modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 14px 34px hsl(var(--primary) / 0.28);
}

.modal-video-title {
    margin-top: 0.7rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
}

.contact-content {
    position: relative;
    z-index: 1;
}

.contact-info,
.contact-form {
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background: hsl(var(--card));
    box-shadow: var(--shadow);
}

.contact-info {
    padding: 2rem;
}

.contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
}

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius);
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.contact-item:hover {
    transform: translateX(6px);
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--accent));
}

.contact-item i {
    width: 42px;
    height: 42px;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) - 0.25rem);
    background: hsl(var(--primary) / 0.10);
    color: hsl(var(--primary));
    transition: transform 0.2s ease, background-color 0.2s ease;
}

.contact-item:hover i {
    transform: scale(1.04);
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
}

.contact-item h4 {
    margin-bottom: 0.25rem;
    font-size: 0.98rem;
}

.contact-item p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.92rem;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.35rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.contact-form:hover {
    transform: translateY(-3px);
    border-color: hsl(var(--primary) / 0.35);
    box-shadow: 0 30px 84px hsl(var(--primary) / 0.10);
}

.form-group input,
.form-group textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.8rem 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) - 0.25rem);
    outline: none;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 0.96rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
}

.form-group textarea {
    min-height: 150px;
    resize: vertical;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: hsl(var(--muted-foreground));
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: hsl(var(--ring));
    background: hsl(var(--popover));
    box-shadow: 0 0 0 4px hsl(var(--ring) / 0.16);
}

.footer {
    padding: 3rem 0;
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--card) / 0.72);
}

.footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
}

.footer-social {
    display: flex;
    gap: 0.75rem;
}

.footer-text {
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
}

.animate-in {
    animation: fadeInUp 0.6s ease-out forwards;
}

.loaded {
    opacity: 1;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes rotate {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-14px);
    }
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
        transform: translateX(-50%) translateY(0);
    }
    40% {
        transform: translateX(-50%) translateY(-8px);
    }
    60% {
        transform: translateX(-50%) translateY(-4px);
    }
}

@keyframes scroll {
    0% {
        opacity: 0;
        transform: translateY(0);
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 0;
        transform: translateY(14px);
    }
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
        opacity: 0.8;
    }
    50% {
        transform: scale(1.25);
        opacity: 1;
    }
}

@keyframes ripple {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

@media (max-width: 1024px) {
    .skills-grid,
    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .school-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 900px) {
    .nav-menu {
        position: fixed;
        top: 80px;
        left: -100%;
        width: calc(100% - 2rem);
        margin-left: 1rem;
        padding: 0.75rem;
        flex-direction: column;
        align-items: stretch;
        border: 1px solid hsl(var(--border));
        border-radius: 1.25rem;
        background: hsl(var(--card) / 0.98);
        box-shadow: 0 24px 70px hsl(222 47% 11% / 0.18);
        backdrop-filter: blur(18px);
        transition: left 0.25s ease;
    }

    .nav-menu.active {
        left: 0;
    }

    .nav-link {
        justify-content: center;
        min-height: 44px;
        width: 100%;
    }

    .hamburger {
        display: inline-flex;
    }

    .contact-btn {
        display: none;
    }

    .hero-container,
    .about-content,
    .contact-content {
        grid-template-columns: 1fr;
        gap: 2.25rem;
    }

    .hero-container {
        padding-top: 1rem;
    }

    .hero-image {
        order: -1;
    }

    .image-backdrop {
        width: min(430px, 100%);
    }

    .tech-circle {
        width: 350px;
        height: 350px;
    }

    .tech-circle::before {
        width: 270px;
        height: 270px;
    }

    .tech-circle::after {
        width: 190px;
        height: 190px;
    }

    .avatar-placeholder {
        width: 310px;
        height: 310px;
    }

    .hero-review-card {
    position: absolute !important;
    bottom: -100px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 3 !important;
    width: auto !important;
    max-width: 220px !important;
    padding: 0.9rem 1.2rem !important;
    border-radius: 1rem !important;
    background: hsla(216, 47%, 98%, 0.6) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid hsla(var(--border), 0.3) !important;
    box-shadow: 0 6px 16px hsla(222, 47%, 11%, 0.08) !important;
    text-align: center !important;
}

    .about-stats {
        grid-template-columns: 1fr;
    }

    .skills-grid,
    .services-grid {
        grid-template-columns: 1fr;
    }

    .projects-grid,
    .school-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 640px) {
    .container,
    .nav-container,
    .hero-container {
        width: min(100% - 2rem, 1120px);
    }

    .hero {
        padding-top: 7rem;
    }

    .hero-title {
        font-size: 2.8rem;
    }

    .hero-description {
        font-size: 1rem;
    }

    .hero-buttons {
        align-items: stretch;
        flex-direction: column;
    }

    .btn-primary,
    .btn-secondary,
    .social-icons {
        width: 100%;
    }

    .social-icons {
        justify-content: flex-start;
    }

    .image-backdrop {
        margin: 0 auto;
        border-radius: 1.5rem;
    }

    .floating-element {
        min-width: 40px;
        height: 30px;
        font-size: 0.72rem;
    }

    .element-1 {
        right: 2%;
    }

    .element-2 {
        left: 1%;
    }

    .element-3 {
        left: -2%;
    }

    .section-header {
        margin-bottom: 3rem;
    }

    .section-title {
        font-size: 2.25rem;
    }

    .portfolio-filter {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 0.25rem;
    }

    .filter-btn {
        flex: 0 0 auto;
    }

    .skills-grid,
    .projects-grid,
    .school-grid,
    .services-grid {
        grid-template-columns: 1fr;
    }

    .contact-info,
    .contact-form {
        padding: 1rem;
        border-radius: 1.25rem;
    }

    .video-modal-dialog {
        padding: 0.75rem;
        border-radius: 1rem;
    }

    .modal-video {
        max-height: 70vh;
    }
}